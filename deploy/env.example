# Settings for deploy/docker-compose.yml. Copy this file to deploy/.env and
# fill in every CHANGE_ME. Generate each secret with:   openssl rand -hex 32

# Where users open openloc. Used in links (password reset, invites).
BASE_URL=http://localhost:8080
# Optional: a host name for the help pages, readable by anyone without signing
# in (e.g. docs.example.com). Point it at the same app; the help then sits at its
# root, and /docs on BASE_URL redirects there. Empty = the help stays at /docs.
DOCS_HOST=
# Optional: the same for the API docs (e.g. developer.example.com); /api-docs on
# BASE_URL then redirects there. Empty = the API docs stay at /api-docs.
DEVELOPER_HOST=
# Host port the app listens on.
APP_PORT=8080

# Database password (the database itself runs in the stack).
POSTGRES_PASSWORD=CHANGE_ME

# Signs sign-in sessions. Changing it signs everyone out. At least 32
# characters, e.g. `openssl rand -hex 32`; the app refuses to start otherwise.
JWT_SECRET=CHANGE_ME

# Encrypts the provider API keys stored in the database (machine translation,
# AI). Keep it safe: if it changes, every stored key becomes unreadable.
AI_SECRETS_KEY=CHANGE_ME

# Key pair for the file storage (SeaweedFS) in the stack. Any values work; the
# app and the storage both read them from here.
S3_ACCESS_KEY=openloc
S3_SECRET_KEY=CHANGE_ME

# Number of reverse proxies in front of the app (Caddy, nginx, a load
# balancer). 0 when users reach APP_PORT directly; usually 1 behind a proxy,
# which must send X-Forwarded-For (deploy/README.md, "Configure").
TRUSTED_PROXY_HOPS=0

# Optional: background tasks run at once by the app. Pre-translation and
# QE+APE runs have their own workers (WORKER_LONG_CONCURRENCY), so a big batch
# of them never holds up the short tasks (WORKER_CONCURRENCY). Default 4 each.
WORKER_CONCURRENCY=
WORKER_LONG_CONCURRENCY=

# Optional: comma-separated emails that may manage every organization
# (the operator console). These people also receive the issues users report
# from the app, by email and under Reported issues, and answer them there.
# Empty: there is no operator console, and the app offers no issue reporting.
PLATFORM_ADMIN_EMAILS=

# The Playground: a shared read-only demo organization that every signed-in
# user can open (the tours start in it). The app builds it at start and
# refreshes it daily. On in this file; empty or false turns it off.
DEMO_ORG=true

# Optional: email (invitations, password resets, notifications). Without it no
# email is sent. Set NOTIFICATION_EMAIL plus either the SMTP_* settings or the
# Google service account, not both. deploy/README.md, "Send email", has the
# setup.
#   NOTIFICATION_EMAIL               the address emails are sent from
NOTIFICATION_EMAIL=

# Any SMTP server.
#   SMTP_HOST                        the server, e.g. smtp.example.com
#   SMTP_PORT                        default 587
#   SMTP_USERNAME / SMTP_PASSWORD    both, or neither for a relay without login;
#                                    the password in single quotes, so a $ in
#                                    it stays as it is
#   SMTP_TLS                         starttls (default), tls (default on port
#                                    465) or none (a relay without login only)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=

# Or a Google Workspace mailbox, through a service account.
#   NOTIFICATION_SERVICE_CLIENT_ID   the service account's client ID (a number)
#   NOTIFICATION_SERVICE_PRIVATE_KEY its private_key, on one line with \n, in
#                                    double quotes, as in the JSON key file
NOTIFICATION_SERVICE_CLIENT_ID=
NOTIFICATION_SERVICE_PRIVATE_KEY=

# Optional: the built-in free machine translation engine. Start the stack with
# `--profile mt` and set this to http://libretranslate:5000. LT_LOAD_ONLY lists
# the languages it downloads on first start.
LIBRETRANSLATE_URL=
LT_LOAD_ONLY=en,de,es,fr

# Optional: use other images than the latest published ones.
# OPENLOC_IMAGE=ghcr.io/modelfront/openloc:latest
# OPENLOC_PARSER_IMAGE=ghcr.io/modelfront/openloc-parser:latest
