{
  "redactTokenPaths": [
    {"name": "invite page", "in": "/invite/abc123", "want": "/invite/[REDACTED]"},
    {"name": "full URL keeps host and query", "in": "https://app.example.com/invite/abc123?error=email_mismatch", "want": "https://app.example.com/invite/[REDACTED]?error=email_mismatch"},
    {"name": "fragment kept", "in": "/invite/abc123#top", "want": "/invite/[REDACTED]#top"},
    {"name": "invite lookup API", "in": "/api/invites/lookup/abc123", "want": "/api/invites/lookup/[REDACTED]"},
    {"name": "password reset page", "in": "/reset-password/abc123", "want": "/reset-password/[REDACTED]"},
    {"name": "shared chart page", "in": "/shared/charts/abc123", "want": "/shared/charts/[REDACTED]"},
    {"name": "only the token segment", "in": "/api/shared/charts/abc123/data", "want": "/api/shared/charts/[REDACTED]/data"},
    {"name": "any case, as the router matches", "in": "/INVITE/abc123", "want": "/INVITE/[REDACTED]"},
    {"name": "every occurrence in free text", "in": "GET /api/invites/lookup/t1 from https://app.example.com/reset-password/t2 failed", "want": "GET /api/invites/lookup/[REDACTED] from https://app.example.com/reset-password/[REDACTED] failed"},
    {"name": "quoted URL ends at the quote", "in": "url=\"/invite/abc123\"", "want": "url=\"/invite/[REDACTED]\""},
    {"name": "idempotent", "in": "/invite/[REDACTED]", "want": "/invite/[REDACTED]"},
    {"name": "trailing slash after the token", "in": "/invite/abc123/", "want": "/invite/[REDACTED]/"},
    {"name": "percent-encoded letter, as the router decodes it", "in": "/%69nvite/abc123", "want": "/%69nvite/[REDACTED]"},
    {"name": "percent-encoded capital letter", "in": "/%49NVITE/abc123", "want": "/%49NVITE/[REDACTED]"},
    {"name": "percent-encoded hyphen, lowercase hex", "in": "/reset%2dpassword/abc123", "want": "/reset%2dpassword/[REDACTED]"},
    {"name": "percent-encoded slash inside a prefix", "in": "/api/invites%2Flookup/abc123", "want": "/api/invites%2Flookup/[REDACTED]"},
    {"name": "every prefix character encoded", "in": "/%73%68%61%72%65%64/%63%68%61%72%74%73/abc123", "want": "/%73%68%61%72%65%64/%63%68%61%72%74%73/[REDACTED]"},
    {"name": "double encoding is no route", "in": "/%2569nvite/abc123", "want": "/%2569nvite/abc123"},
    {"name": "encoded longer segment is no prefix", "in": "/%69nvites/abc123", "want": "/%69nvites/abc123"},
    {"name": "invites by id is no token path", "in": "/api/invites/123", "want": "/api/invites/123"},
    {"name": "bare invite", "in": "/invite", "want": "/invite"},
    {"name": "empty token segment", "in": "/invite/", "want": "/invite/"},
    {"name": "lookup with no token", "in": "/api/invites/lookup", "want": "/api/invites/lookup"},
    {"name": "prefix inside a longer segment", "in": "/reinvite/abc123", "want": "/reinvite/abc123"},
    {"name": "a longer first segment", "in": "/invite-members/abc123", "want": "/invite-members/abc123"},
    {"name": "reset-password API carries no token", "in": "/api/auth/reset-password", "want": "/api/auth/reset-password"},
    {"name": "accept-invite API carries no token", "in": "/api/auth/accept-invite", "want": "/api/auth/accept-invite"},
    {"name": "unrelated path", "in": "/projects/7/jobs/42", "want": "/projects/7/jobs/42"},
    {"name": "empty", "in": "", "want": ""}
  ],
  "scrubURL": [
    {"name": "query and fragment cut, token redacted", "in": "https://app.example.com/invite/abc123?error=email_mismatch#x", "want": "https://app.example.com/invite/[REDACTED]"},
    {"name": "relative path", "in": "/api/invites/lookup/abc123?lang=en", "want": "/api/invites/lookup/[REDACTED]"},
    {"name": "userinfo dropped", "in": "https://user:pass@app.example.com/editor?source_text=SECRET", "want": "https://app.example.com/editor"},
    {"name": "unparseable URL is cut", "in": "%%%/reset-password/abc123?x=1", "want": "%%%/reset-password/[REDACTED]"},
    {"name": "encoded prefix keeps its encoding", "in": "https://app.example.com/%69nvite/abc123?x=1", "want": "https://app.example.com/%69nvite/[REDACTED]"},
    {"name": "already redacted URL", "in": "https://app.example.com/invite/[REDACTED]", "want": "https://app.example.com/invite/[REDACTED]"},
    {"name": "already redacted path with a query", "in": "/invite/[REDACTED]?error=1", "want": "/invite/[REDACTED]"},
    {"name": "clean path", "in": "/api/projects/7", "want": "/api/projects/7"},
    {"name": "empty", "in": "", "want": ""}
  ],
  "scrubMessage": [
    {"name": "query cut from a URL", "in": "GET https://x.com/api/tm/lookup?source_text=SECRET failed", "want": "GET https://x.com/api/tm/lookup failed"},
    {"name": "quoted URL keeps its closing quote", "in": "fetch url=\"https://x.com/p?q=1\" failed", "want": "fetch url=\"https://x.com/p\" failed"},
    {"name": "token path in a relative URL", "in": "GET /api/invites/lookup/abc123 failed", "want": "GET /api/invites/lookup/[REDACTED] failed"},
    {"name": "encoded token path in a full URL", "in": "opened https://x.com/%69nvite/abc123?x=1 then failed", "want": "opened https://x.com/%69nvite/[REDACTED] then failed"},
    {"name": "JWT", "in": "bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.abcdefgh rejected", "want": "bearer [REDACTED] rejected"},
    {"name": "long hex run", "in": "key 0123456789abcdef0123456789abcdef0123 refused", "want": "key [REDACTED] refused"},
    {"name": "short hex kept", "in": "commit 0123abcd failed", "want": "commit 0123abcd failed"},
    {"name": "plain text", "in": "something broke", "want": "something broke"}
  ]
}
