{
  "id": "builtin:ru@1",
  "name": "Russian",
  "source_language": "ru",
  "description": "Russian abbreviations (Unicode CLDR, curated) and sentence-ending punctuation.",
  "rule_set": {
    "mode": "sentence",
    "rules": [
      {
        "before": "(?:^|\\P{L})\\p{Ll}\\.",
        "after": "",
        "break": false
      },
      {
        "before": "[.!?…][\\p{Pe}\\p{Pf}\"']*",
        "after": "[\\t\\n\\v\\f\\r\\x{85}\\p{Z}]+[\\p{Lu}\\p{Lt}\\p{Lo}\\p{Nd}\\p{Ps}\\p{Pi}\"'¿¡]",
        "break": true
      },
      {
        "before": "[。！？｡]",
        "after": "[^\\p{Pe}\\p{Pf}。！？｡]",
        "break": true
      }
    ],
    "abbreviations": [
      "руб",
      "янв",
      "до н. э",
      "сент",
      "тел",
      "дек",
      "февр",
      "нояб",
